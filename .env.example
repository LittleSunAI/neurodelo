# Durable local persistence. Later replace file with PostgreSQL/Redis adapters.
PERSISTENCE_DRIVER=file
NEURODELO_DATA_DIR=.data
NEXT_PUBLIC_USE_DURABLE_LOCAL_STATE=true
LOCAL_STATE_MAX_BYTES=4194304

# Stable session secret. Use at least 32 random characters outside local development.
AUTH_SECRET=
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
ENABLE_HSTS=false
ENABLE_DESIGN_LAB=false


# Secure local object storage foundation. Later replace with MinIO/S3.
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_FILES_PER_DAY=20
UPLOAD_MAX_IMAGE_PIXELS=20000000
UPLOAD_MAX_IMAGE_DIMENSION=8192
OBJECT_AUTO_APPROVE_SAFE=true
OBJECT_RETENTION_DAYS=30
LOCAL_JOB_RETENTION_DAYS=14

# Local fallback switches
NEXT_PUBLIC_USE_FALLBACKS=true
NEXT_PUBLIC_USE_GAME_FALLBACKS=true
NEXT_PUBLIC_USE_HERO_IMAGE_FALLBACKS=true
NEXT_PUBLIC_USE_GIT_FALLBACKS=true
NEXT_PUBLIC_USE_COMMUNITY_FALLBACKS=true
NEXT_PUBLIC_USE_MODERATION_FALLBACKS=true

# fal.ai provider and server-side spending protection
FAL_KEY=
FAL_HERO_MODEL_ID=
FAL_ALLOWED_MODEL_IDS=
FAL_ALLOWED_IMAGE_HOSTS=fal.media
FAL_MAX_GENERATIONS_PER_DAY=5
FAL_MAX_REQUESTS_PER_MINUTE=2
FAL_MAX_ESTIMATED_DAILY_USD=1
FAL_ESTIMATED_COST_PER_GENERATION_USD=0.08
FAL_REQUEST_TIMEOUT_MS=45000

# Email provider
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REQUEST_TIMEOUT_MS=10000

# Future infrastructure contracts. Keep blank until the real services are started.
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GAME_ENGINE_SECRET=
MODERATION_SERVICE_SECRET=
